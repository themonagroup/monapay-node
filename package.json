{
  "name": "@monapay/node",
  "version": "0.4.0",
  "description": "SDK Node.js zero-dependency cho MONA Pay",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themonagroup/monapay-node.git"
  },
  "keywords": [
    "monapay",
    "vietqr",
    "virtual-account",
    "payment",
    "webhook",
    "email"
  ],
  "license": "MIT",
  "homepage": "https://monapay.vn/docs",
  "bugs": {
    "url": "https://github.com/themonagroup/monapay-node/issues"
  }
}
